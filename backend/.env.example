APP_ENV=local                 # local | production
AUTH_MODE=mock                # mock | cognito
DATABASE_URL=postgresql+psycopg://tripvault:tripvault@localhost:5432/tripvault
S3_BUCKET=tripvault-files
S3_ENDPOINT_URL=http://localhost:9000        # leave EMPTY on AWS (EC2 IAM role is used)
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000 # leave EMPTY on AWS
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: ONLY for MinIO locally. Never set on EC2.
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
CORS_ORIGINS=http://localhost:3000
MOCK_DEFAULT_USER=mock-elena
